
@{
    ViewData["Title"] = "Chat with Brett";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 class="text-3xl font-bold mb-6">Chat with Brett</h1>
<div class="grid gap-4 max-w-3xl">
    <div class="rounded-2xl border border-white/10 p-4 bg-slate-900 w-full">
        <div id="chat-messages-page" class="h-80 overflow-y-auto space-y-3 pr-1"></div>
        <div class="mt-3 flex gap-2">
            <input id="chat-input-page" class="input flex-1" placeholder="Ask about experience, Azure, SQL, projects..." />
            <button class="btn-primary" onclick="sendChatPage()">Send</button>
        </div>
        <p id="chat-error-page" class="text-red-400 text-xs mt-2 hidden"></p>
    </div>
</div>
