@{
    ViewData["Title"] = "Azure & DevOps";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 class="text-3xl font-bold mb-6">Azure &amp; DevOps</h1>

<div class="grid gap-6 md:grid-cols-2">

    <!-- Azure platform -->
    <article class="rounded-2xl border border-white/10 bg-slate-900 hover:bg-sky-700 p-5">
        <h3 class="text-xl font-semibold">Azure</h3>
        <ul class="mt-3 list-disc list-outside pl-6 text-slate-300 space-y-1">
            <li>App Service hosting with <strong>deployment slots</strong> (blue/green), slot settings, and safe swaps.</li>
            <li>Key Vault for secrets; <strong>App Settings ↔ Key Vault reference</strong> to keep code secret-free.</li>
            <li>Storage for assets/diagnostics; lifecycle rules for log retention and cost control.</li>
            <li>Front Door as an entry point; health probes and origin groups for failover.</li>
            <li>App Insights for traces, live metrics, and <strong>KQL</strong> alerts (error-rate, cold starts, SLIs).</li>
        </ul>
        <div class="badge-row mt-4">
            <span class="badge">App Service</span><span class="badge">Key Vault</span>
            <span class="badge">Front Door</span><span class="badge">Storage</span>
            <span class="badge">App Insights</span>
        </div>
    </article>

    <!-- CI/CD -->
    <article class="rounded-2xl border border-white/10 bg-slate-900 hover:bg-sky-700 p-5">
        <h3 class="text-xl font-semibold">CI/CD</h3>
        <ul class="mt-3 list-disc list-outside pl-6 text-slate-300 space-y-1">
            <li>GitHub Actions &amp; Azure DevOps pipelines for <strong>build → test → package → deploy</strong>.</li>
            <li>Quality gates: unit tests, lint, and health warm-ups post-deploy.</li>
            <li>Multi-stage promotion (dev → stage → prod) with approvals and manual rollback.</li>
            <li>Versioning strategy (semver) and artifact retention for reproducible releases.</li>
        </ul>
        <div class="badge-row mt-4">
            <span class="badge">GitHub Actions</span><span class="badge">Azure DevOps</span>
            <span class="badge">Release Gates</span><span class="badge">Approvals</span>
        </div>
    </article>

    <!-- Example: Actions to App Service with slots -->
    <article class="rounded-2xl border border-white/10 bg-slate-900 hover:bg-sky-700 p-5">
        <h3 class="text-xl font-semibold">Example: Web App deploy with slots</h3>
        <p class="mt-2 text-slate-300">
            Build/tests run, package published, deploy to <em>staging</em> slot, warm-up health check, then swap.
        </p>
<pre class="mt-3 overflow-x-auto text-xs leading-5"><code class="language-yaml"># .github/workflows/webapp.yml
name: webapp
on: { push: { branches: [ main ] } }

jobs:
  build-test-deploy:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout&#64;v4
    - uses: actions/setup-dotnet&#64;v4
      with: { dotnet-version: '8.0.x' }
    - run: dotnet restore
    - run: dotnet build --configuration Release --no-restore
    - run: dotnet test  --configuration Release --no-build --collect:"XPlat Code Coverage"
    - run: dotnet publish ./BrettGravesPortfolio -c Release -o out

    - uses: azure/webapps-deploy&#64;v3
      with:
        app-name: ${{ secrets.AZURE_WEBAPP_NAME }}
        slot-name: staging
        publish-profile: ${{ secrets.AZURE_PUBLISH_PROFILE }}
        package: ./out

    # Warm-up gate before swap
    - name: Health check
      run: curl -fsS https://${{ secrets.AZURE_WEBAPP_NAME }}-staging.azurewebsites.net/health

    - name: Swap to production
      run: az webapp deployment slot swap -g ${{ secrets.AZURE_RG }} \
           -n ${{ secrets.AZURE_WEBAPP_NAME }} --slot staging --target-slot production
</code></pre>
        <div class="badge-row mt-4">
            <span class="badge">.NET 8</span><span class="badge">Actions</span>
            <span class="badge">Slots</span><span class="badge">Health Gate</span>
        </div>
    </article>

    <!-- Example: Bicep + KV secret reference -->
    <article class="rounded-2xl border border-white/10 bg-slate-900 hover:bg-sky-700 p-5">
        <h3 class="text-xl font-semibold">Example: Infra as Code (Bicep)</h3>
        <p class="mt-2 text-slate-300">
            Minimal App Service + Key Vault, with an app setting that references a secret (no secrets in code).
        </p>
<pre class="mt-3 overflow-x-auto text-xs leading-5"><code class="language-bicep">param name string
param kvName string
param secretName string

resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: '${name}-plan'
  location: resourceGroup().location
  sku: { name: 'B1', tier: 'Basic', capacity: 1 }
}

resource web 'Microsoft.Web/sites@2023-12-01' = {
  name: name
  location: resourceGroup().location
  properties: {
    serverFarmId: plan.id
    siteConfig: {
      appSettings: [
        {
          name: 'ConnString'
          value: '&#64;Microsoft.KeyVault(SecretUri=https://${kvName}.vault.azure.net/secrets/${secretName})'
        }
      ]
    }
  }
}
</code></pre>
        <div class="badge-row mt-4">
            <span class="badge">Bicep</span><span class="badge">IaC</span>
            <span class="badge">Key Vault Ref</span><span class="badge">App Service</span>
        </div>
    </article>

    <!-- Example: Observability with KQL -->
    <article class="rounded-2xl border border-white/10 bg-slate-900 hover:bg-sky-700 p-5 md:col-span-2">
        <h3 class="text-xl font-semibold">Example: Observability (KQL)</h3>
        <p class="mt-2 text-slate-300">
            Alert on rising server errors with a short lookback and suppression window to avoid noise.
        </p>
<pre class="mt-3 overflow-x-auto text-xs leading-5"><code class="language-sql">// App Insights - request failure rate
requests
| where timestamp &gt; ago(10m)
| summarize total = count(), failures = countif(resultCode startswith "5")
| extend failureRate = failures * 100.0 / total
| where total &gt; 100 and failureRate &gt; 2
</code></pre>
        <div class="badge-row mt-4">
            <span class="badge">App Insights</span><span class="badge">KQL</span>
            <span class="badge">SLI/SLO</span><span class="badge">Alerts</span>
        </div>
    </article>

</div>